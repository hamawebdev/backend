# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://medcin_user:medcin_password@localhost:5432/medcin_platform?schema=public

# PostgreSQL Database Settings
POSTGRES_USER=medcin_user
POSTGRES_PASSWORD=medcin_password
POSTGRES_DB=medcin_platform

# Application Configuration
NODE_ENV=development
# Use PORT=8080 for Docker, PORT=3005 for local non-Docker dev
PORT=8080

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOADS_DIR=./uploads

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
