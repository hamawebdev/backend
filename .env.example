# Copy to .env for local development. Production values are set in Dokploy.

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medadn

NODE_ENV=development
PORT=8080

# Required in production: long random strings (e.g. `openssl rand -base64 48`)
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRY=25d

# Absolute path inside the container; the Dokploy volume is mounted here
UPLOADS_DIR=/app/uploads

# Web app origin: used for CORS and OAuth redirects
CLIENT_URL=http://localhost:3000
# Optional comma-separated CORS allowlist (defaults to CLIENT_URL)
CORS_ORIGINS=

# Chargily Pay
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test
APP_BASE_URL=http://localhost:3000
PAYMENTS_SUCCESS_PATH=/payments/success
PAYMENTS_FAILURE_PATH=/payments/failure
WEBHOOK_PUBLIC_URL=http://localhost:8080/api/v1/payments/webhook

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
