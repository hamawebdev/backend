**2) Checkout creation**

```ts
// payments.controller.ts
import type { Request, Response } from 'express';
import crypto from 'crypto';
import { prisma } from '../prisma';

const base = process.env.CHARGILY_MODE === 'live'
  ? 'https://pay.chargily.net/api/v2'
  : 'https://pay.chargily.net/test/api/v2';

export async function createCheckout(req: Request, res: Response) {
  const { userId, studyPackId, amountDzd, locale = 'ar', activationCode, paymentMethod = 'edahabia' } = req.body;

  // (Optional) pre-validate activation code (no mutation)
  if (activationCode) {
    const code = await prisma.activationCode.findUnique({ where: { code: activationCode } });
    if (!code || !code.isActive || code.expiresAt < new Date() || code.currentUses >= code.maxUses) {
      return res.status(400).json({ error: 'Invalid or expired activation code' });
    }
  }

  // Create pending subscription
  const now = new Date();
  const months = 1; // or derive from studyPack, or from activationCode.durationMonths if supplied
  const end = new Date(now);
  end.setMonth(end.getMonth() + months);

  const subscription = await prisma.subscription.create({
    data: {
      userId,
      studyPackId,
      status: 'PENDING',
      startDate: now,
      endDate: end,
      amountPaid: amountDzd,
      paymentMethod,
    }
  });

  // Build checkout payload
  const payload = {
    amount: amountDzd,
    currency: 'dzd',
    payment_method: paymentMethod,                  // 'edahabia' | 'cib' | 'chargily_app'
    success_url: `${process.env.APP_BASE_URL}${process.env.PAYMENTS_SUCCESS_PATH}`,
    failure_url: `${process.env.APP_BASE_URL}${process.env.PAYMENTS_FAILURE_PATH}`,
    webhook_endpoint: process.env.WEBHOOK_PUBLIC_URL,
    locale,
    chargily_pay_fees_allocation: 'customer',       // business choice
    metadata: {
      subscriptionId: String(subscription.id),
      userId: String(userId),
      studyPackId: String(studyPackId),
      ...(activationCode ? { activationCode } : {})
    }
  };

  const resp = await fetch(`${base}/checkouts`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${process.env.CHARGILY_SECRET_KEY}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify(payload)
  });

  if (!resp.ok) {
    const err = await resp.text();
    return res.status(502).json({ error: 'Chargily create checkout failed', details: err });
  }

  const data = await resp.json(); // includes checkout_url
  return res.json({ checkoutUrl: data.checkout_url, checkoutId: data.id });
}
```

**3) Webhook handler**

```ts
// webhook.controller.ts
import type { Request, Response } from 'express';
import crypto from 'crypto';
import { prisma } from '../prisma';

export async function webhookHandler(req: Request, res: Response) {
  const signature = req.header('signature');
  const raw = (req as any).body?.toString?.() ?? ''; // because express.raw
  if (!signature || !raw) return res.sendStatus(400);

  const h = crypto.createHmac('sha256', process.env.CHARGILY_SECRET_KEY!);
  h.update(raw, 'utf8');
  const computed = h.digest('hex');

  // constant-time compare
  if (!crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(computed))) {
    return res.sendStatus(403);
  }

  const event = JSON.parse(raw) as {
    id: string;
    type: 'checkout.paid' | 'checkout.failed';
    data: any;
  };

  // idempotency
  try {
    await prisma.paymentEvent.create({ data: { id: event.id, type: event.type, checkoutId: event.data?.id || null } });
  } catch {
    return res.sendStatus(200); // already processed
  }

  if (event.type === 'checkout.paid') {
    const m = event.data?.metadata || {};
    const subscriptionId = Number(m.subscriptionId);
    const activationCode = m.activationCode as string | undefined;

    await prisma.$transaction(async (tx) => {
      // activate subscription
      await tx.subscription.update({ where: { id: subscriptionId }, data: {
        status: 'ACTIVE',
        paymentReference: event.data?.id ?? null,
        paymentMethod: event.data?.payment_method ?? undefined,
        amountPaid: event.data?.amount ?? undefined,
      }});

      if (activationCode) {
        const code = await tx.activationCode.findUnique({ where: { code: activationCode }, lock: { mode: 'ForUpdate' } });
        if (!code || !code.isActive || code.expiresAt < new Date() || code.currentUses >= code.maxUses) return;
        await tx.activationCode.update({
          where: { code: activationCode },
          data: { currentUses: { increment: 1 }, isActive: code.currentUses + 1 < code.maxUses ? code.isActive : false }
        });
        await tx.codeRedemption.create({
          data: { activationCodeId: code.id, userId: event.data?.customer_id ? Number(m.userId) : Number(m.userId), subscriptionId }
        });
      }
    });
  }

  if (event.type === 'checkout.failed') {
    const subscriptionId = Number(event.data?.metadata?.subscriptionId);
    if (Number.isFinite(subscriptionId)) {
      await prisma.subscription.update({ where: { id: subscriptionId }, data: { status: 'CANCELED' } });
    }
  }

  return res.sendStatus(200);
}
```

