generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// USERS & AUTHENTICATION
// ===========================================

model University {
  id        Int      @id @default(autoincrement())
  name      String
  country   String   @default("Algeria")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]
  quizzes   Quiz[]
  questions Question[]
  exams     Exam[]

  @@map("universities")
  @@index([name])
}

model Specialty {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@map("specialties")
  @@index([name])
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String?        @map("password_hash")
  fullName      String         @map("full_name")
  role          UserRole       @default(STUDENT)
  universityId  Int?           @map("university_id")
  specialtyId   Int?           @map("specialty_id")
  currentYear   YearLevel?     @map("current_year")
  emailVerified Boolean        @default(false) @map("email_verified")
  isActive      Boolean        @default(true) @map("is_active")
  lastLogin     DateTime?      @map("last_login")
  resetCode     String?        @map("reset_code")
  resetCodeExpiresAt DateTime? @map("reset_code_expires_at")
  googleId      String?        @unique @map("google_id")
  avatarUrl     String?        @map("avatar_url")
  authProvider  AuthProvider   @default(LOCAL) @map("auth_provider")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  university    University?    @relation(fields: [universityId], references: [id], onDelete: SetNull)
  specialty     Specialty?     @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  createdQuizzes Quiz[]
  createdExams  Exam[]
  quizSessions  QuizSession[]
  courseProgress CourseProgress[]
  studentLabels StudentLabel[]
  quizLabels    QuizLabel[]
  questionLabels QuestionLabel[]
  quizSessionLabels QuizSessionLabel[]
  studentNotes  StudentNote[]
  noteLabels    NoteLabel[]
  questionReports QuestionReport[]
  todoItems     TodoItem[]
  employeeActivities EmployeeActivity[]
  courseLayers  CourseLayer[]
  subscriptions Subscription[]
  reviewedReports QuestionReport[] @relation("ReportReviewer")
  createdQuestions Question[]
  createdActivationCodes ActivationCode[] @relation("CreatedActivationCodes")
  codeRedemptions CodeRedemption[]
  studentCards  StudentCard[]

  @@map("users")
  @@index([email])
  @@index([role])
  @@index([universityId])
  @@index([specialtyId])
  @@index([currentYear])
  @@index([googleId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  deviceFingerprint String? @map("device_fingerprint")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([token])
  @@index([expiresAt])
  @@index([userId])
}

// ===========================================
// CONTENT STRUCTURE
// ===========================================

model StudyPack {
  id              Int                       @id @default(autoincrement())
  name            String
  description     String?
  type            String
  yearNumber      String?                   @map("year_number")
  pricePerMonth   Decimal                  @map("price_per_month")
  pricePerYear    Decimal?                  @map("price_per_year")
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  activationCodes ActivationCodeStudyPack[]
  subscriptions   Subscription[]
  unites          Unite[]

  @@index([type])
  @@index([yearNumber])
  @@index([isActive])
  @@map("study_packs")
}

model Unite {
  id          Int      @id @default(autoincrement())
  studyPackId Int      @map("study_pack_id")
  name        String
  description String?
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  studyPack   StudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)
  modules     Module[]

  @@map("unites")
}

model Module {
  id        Int      @id @default(autoincrement())
  uniteId   Int?     @map("unite_id")
  name      String
  description String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unite      Unite?   @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  courses    Course[]
  exams      Exam[]
  books      ModuleBook[]

  @@map("modules")
}

model ModuleBook {
  id          Int      @id @default(autoincrement())
  moduleId    Int      @map("module_id")
  name        String
  coverPath   String?  @map("cover_path")
  viewUrl     String   @map("view_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_books")
  @@index([moduleId])
}

model Course {
  id          Int      @id @default(autoincrement())
  moduleId    Int      @map("module_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseLayers CourseLayer[]
  courseResources CourseResource[]
  quizzes     Quiz[]
  questions   Question[]
  courseProgress CourseProgress[]
  todoItems   TodoItem[]
  studentCardCourses StudentCardCourse[]

  @@map("courses")
}

model CourseLayer {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  studentId   Int      @map("student_id")
  layerNumber Int      @map("layer_number")
  isCompleted Boolean  @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("course_layers")
  @@unique([courseId, studentId, layerNumber])
  @@index([courseId, studentId])
  @@index([layerNumber])
}

model StudentCard {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses     StudentCardCourse[]

  @@map("student_cards")
  @@index([userId])
}

model StudentCardCourse {
  id        Int      @id @default(autoincrement())
  cardId    Int      @map("card_id")
  courseId  Int      @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")

  card      StudentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("student_card_courses")
  @@unique([cardId, courseId])
  @@index([cardId])
  @@index([courseId])
}

model CourseResource {
  id            Int      @id @default(autoincrement())
  courseId      Int      @map("course_id")
  type          ResourceType
  title         String
  description   String?
  filePath      String?  @map("file_path")
  externalUrl   String?  @map("external_url")
  youtubeVideoId String? @map("youtube_video_id")
  isPaid        Boolean  @default(false) @map("is_paid")
  price         Float?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_resources")
  @@index([courseId, type])
  @@index([isPaid])
}

// ===========================================
// SUBSCRIPTIONS & PAYMENTS
// ===========================================

model Subscription {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  studyPackId     Int      @map("study_pack_id")
  status          SubscriptionStatus @default(PENDING)
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  amountPaid      Float    @map("amount_paid")
  paymentMethod   String?  @map("payment_method")
  paymentReference String? @map("payment_reference")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPack       StudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)
  codeRedemptions CodeRedemption[]

  @@map("subscriptions")
  @@index([userId, studyPackId])
  @@index([status])
  @@index([startDate, endDate])
}

model PaymentEvent {
  id          String   @id
  type        String
  checkoutId String?
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("payment_events")
  @@index([type])
  @@index([checkoutId])
  @@index([processedAt])
}

// ===========================================
// QUIZ SYSTEM
// ===========================================



model QuestionSource {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions Question[]

  @@map("question_sources")
  @@index([name])
}

model Quiz {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        QuizType @default(PRACTICE)
  courseId    Int?     @map("course_id")
  universityId Int?    @map("university_id")
  yearLevel   YearLevel? @map("year_level")
  quizYear    Int?     @map("quiz_year")
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  university  University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  examQuizzes ExamQuiz[]
  quizSessions QuizSession[]
  quizLabels  QuizLabel[]
  studentNotes StudentNote[]
  todoItems   TodoItem[]

  @@map("quizzes")
  @@index([type])
  @@index([courseId])
  @@index([universityId, yearLevel])
  @@index([quizYear])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  QROC
}

model Question {
  id          Int      @id @default(autoincrement())
  courseId    Int?     @map("course_id")
  examId      Int?     @map("exam_id")  // New field to link questions to specific exams
  sourceId    Int?     @map("source_id")  // New field to link questions to question sources
  questionText String  @map("question_text")
  explanation String?
  questionType QuestionType @default(SINGLE_CHOICE) @map("question_type")
  universityId Int?    @map("university_id")
  yearLevel   YearLevel? @map("year_level")
  examYear    Int?     @map("exam_year")  // NEW: Unified exam year field
  metadata    String?  @map("metadata")   // NEW: Optional metadata field for additional question information
  tags        String   @default("[]")        // NEW: Array of tag strings for categorization (JSON string)
  repetitionCount Int  @default(0) @map("repetition_count")  // Number of times this question has appeared in exams
  repetitionYears String @default("[]") @map("repetition_years") // Years in which this question has appeared (JSON string)
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  exam        Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  source      QuestionSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  university  University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  examQuestions ExamQuestion[]
  questionAnswers QuestionAnswer[]
  questionImages QuestionImage[]
  questionExplanationImages QuestionExplanationImage[]
  questionLabels QuestionLabel[]
  studentNotes StudentNote[]
  questionReports QuestionReport[]
  sessionQuestions QuizSessionQuestion[]
  quizAttempts QuizAttempt[]
  multipleChoiceAttempts MultipleChoiceAttempt[]

  @@map("questions")
  @@index([courseId])
  @@index([examId])
  @@index([sourceId])
  @@index([universityId, yearLevel])
  @@index([questionType])
  @@index([examYear])
  @@index([universityId, examYear])
  @@index([repetitionCount])
}

model QuizQuestion {
  id         Int      @id @default(autoincrement())
  quizId     Int      @map("quiz_id")
  questionId Int      @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")

  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
  @@unique([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
}

model QuestionAnswer {
  id          Int      @id @default(autoincrement())
  questionId  Int      @map("question_id")
  answerText  String   @map("answer_text")
  isCorrect   Boolean  @default(false) @map("is_correct")
  explanation String?
  createdAt   DateTime @default(now()) @map("created_at")

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  explanationImages ExplanationImage[]
  quizAttempts QuizAttempt[]

  @@map("question_answers")
  @@index([questionId])
}

model ExplanationImage {
  id        Int      @id @default(autoincrement())
  answerId  Int      @map("answer_id")
  imagePath String   @map("image_path")
  altText   String?  @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")

  answer    QuestionAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@map("explanation_images")
  @@index([answerId])
}

model QuestionImage {
  id         Int      @id @default(autoincrement())
  questionId Int      @map("question_id")
  imagePath  String   @map("image_path")
  altText    String?  @map("alt_text")
  createdAt  DateTime @default(now()) @map("created_at")

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_images")
  @@index([questionId])
}

model QuestionExplanationImage {
  id         Int      @id @default(autoincrement())
  questionId Int      @map("question_id")
  imagePath  String   @map("image_path")
  altText    String?  @map("alt_text")
  createdAt  DateTime @default(now()) @map("created_at")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_explanation_images")
  @@index([questionId])
}

// ===========================================
// EXAMS SYSTEM
// ===========================================

model Exam {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  moduleId    Int      @map("module_id")
  universityId Int     @map("university_id")
  yearLevel   YearLevel @map("year_level")
  examYear    DateTime @map("exam_year")
  year        Int      // 4-digit year like 2024
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  university  University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  examQuizzes ExamQuiz[]
  examQuestions ExamQuestion[]
  questions   Question[] // Questions directly associated with this exam
  quizSessions QuizSession[]
  todoItems   TodoItem[]

  @@map("exams")
  @@index([universityId, yearLevel])
  @@index([moduleId])
  @@index([year])
  @@index([moduleId, year])
}

model ExamQuiz {
  id        Int      @id @default(autoincrement())
  examId    Int      @map("exam_id")
  quizId    Int      @map("quiz_id")
  createdAt DateTime @default(now()) @map("created_at")

  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("exam_quizzes")
  @@unique([examId, quizId])
  @@index([examId])
}

model ExamQuestion {
  id         Int      @id @default(autoincrement())
  examId     Int      @map("exam_id")
  questionId Int      @map("question_id")
  orderInExam Int?    @map("order_in_exam") // Manual ordering of questions within exam
  createdAt  DateTime @default(now()) @map("created_at")

  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("exam_questions")
  @@unique([examId, questionId])
  @@index([examId])
  @@index([examId, orderInExam])
}

// ===========================================
// QUIZ SESSIONS & ATTEMPTS
// ===========================================

model QuizSession {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  quizId        Int?     @map("quiz_id")
  examId        Int?     @map("exam_id")
  title         String
  type          SessionType @default(PRACTICE)
  quizType      QuizType? @map("quiz_type") // QCM, QCS, etc.
  status        SessionStatus @default(NOT_STARTED)
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  score         Float    @default(0)
  percentage    Float    @default(0)
  // Retake functionality fields
  originalSessionId Int?  @map("original_session_id") // Reference to original session for retakes
  retakeType    RetakeType? @map("retake_type") // Type of retake (same, incorrect_only, etc.)
  isRetake      Boolean  @default(false) @map("is_retake") // Flag to identify retake sessions
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz          Quiz?    @relation(fields: [quizId], references: [id], onDelete: SetNull)
  exam          Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  originalSession QuizSession? @relation("SessionRetakes", fields: [originalSessionId], references: [id], onDelete: SetNull)
  retakeSessions QuizSession[] @relation("SessionRetakes")
  sessionQuestions QuizSessionQuestion[]
  quizAttempts  QuizAttempt[]
  multipleChoiceAttempts MultipleChoiceAttempt[]
  quizSessionLabels QuizSessionLabel[]
  todoItems     TodoItem[]

  @@map("quiz_sessions")
  @@index([userId, status])
  @@index([type])
  @@index([quizId])
  @@index([examId])
  @@index([originalSessionId])
  @@index([isRetake])
}

model QuizSessionQuestion {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  questionId Int      @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")

  session    QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_session_questions")
  @@unique([sessionId, questionId])
  @@index([sessionId])
}

model QuizAttempt {
  id              Int      @id @default(autoincrement())
  sessionId       Int      @map("session_id")
  questionId      Int      @map("question_id")
  selectedAnswerId Int?    @map("selected_answer_id")
  textAnswer      String?  @map("text_answer") // For QROC questions
  isCorrect       Boolean?
  userManualCorrection Boolean? @map("user_manual_correction") // If true, isCorrect was set by user (self-grading)
  answeredAt      DateTime? @map("answered_at")
  createdAt       DateTime @default(now()) @map("created_at")

  session         QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer  QuestionAnswer? @relation(fields: [selectedAnswerId], references: [id], onDelete: SetNull)

  @@map("quiz_attempts")
  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@index([isCorrect])
}

model MultipleChoiceAttempt {
  id              Int      @id @default(autoincrement())
  sessionId       Int      @map("session_id")
  questionId      Int      @map("question_id")
  selectedAnswerIds String @map("selected_answer_ids") // JSON array of answer IDs
  isCorrect       Boolean?
  partialScore    Float?   @map("partial_score") // For partial credit scoring
  answeredAt      DateTime? @map("answered_at")
  createdAt       DateTime @default(now()) @map("created_at")

  session         QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("multiple_choice_attempts")
  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@index([isCorrect])
}

// ===========================================
// ACTIVATION CODES SYSTEM
// ===========================================

model ActivationCode {
  id              Int      @id @default(autoincrement())
  code            String   @unique @map("code")
  hashedCode      String   @map("hashed_code") // For security
  description     String?
  durationMonths  Int      @map("duration_months") // Subscription duration (used when durationType is MONTHS)
  durationDays    Int?     @map("duration_days") // Subscription duration in days (used when durationType is DAYS)
  durationType    String   @default("MONTHS") @map("duration_type") // 'MONTHS' | 'DAYS'
  maxUses         Int      @default(1) @map("max_uses") // How many times code can be used
  currentUses     Int      @default(0) @map("current_uses") // Current usage count
  isActive        Boolean  @default(true) @map("is_active")
  expiresAt       DateTime @map("expires_at") // Code expiration date
  createdById     Int      @map("created_by_id") // Admin who created the code
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy       User     @relation("CreatedActivationCodes", fields: [createdById], references: [id], onDelete: Cascade)
  studyPacks      ActivationCodeStudyPack[] // Many-to-many with study packs
  redemptions     CodeRedemption[] // Track all redemptions

  @@map("activation_codes")
  @@index([code])
  @@index([isActive, expiresAt])
  @@index([createdById])
}

model ActivationCodeStudyPack {
  id              Int      @id @default(autoincrement())
  activationCodeId Int     @map("activation_code_id")
  studyPackId     Int      @map("study_pack_id")
  createdAt       DateTime @default(now()) @map("created_at")

  activationCode  ActivationCode @relation(fields: [activationCodeId], references: [id], onDelete: Cascade)
  studyPack       StudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)

  @@unique([activationCodeId, studyPackId])
  @@map("activation_code_study_packs")
  @@index([activationCodeId])
  @@index([studyPackId])
}

model CodeRedemption {
  id              Int      @id @default(autoincrement())
  activationCodeId Int     @map("activation_code_id")
  userId          Int      @map("user_id")
  subscriptionId  Int?     @map("subscription_id")
  redeemedAt      DateTime @default(now()) @map("redeemed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  activationCode  ActivationCode @relation(fields: [activationCodeId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("code_redemptions")
  @@index([activationCodeId])
  @@index([userId])
  @@index([subscriptionId])
}

// ===========================================
// STUDENT PROGRESS & NOTES
// ===========================================

model CourseProgress {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  courseId          Int      @map("course_id")
  layer1Completed   Boolean  @default(false) @map("layer_1_completed")
  layer2Completed   Boolean  @default(false) @map("layer_2_completed")
  layer3Completed   Boolean  @default(false) @map("layer_3_completed")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_progress")
  @@unique([userId, courseId])
  @@index([userId])
}

model StudentLabel {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizLabels QuizLabel[]
  questionLabels QuestionLabel[]
  quizSessionLabels QuizSessionLabel[]
  noteLabels NoteLabel[]

  @@map("student_labels")
  @@index([userId])
}

model QuizLabel {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  quizId    Int      @map("quiz_id")
  labelId   Int      @map("label_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  label     StudentLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@map("quiz_labels")
  @@unique([userId, quizId, labelId])
  @@index([userId, quizId])
  @@index([labelId])
}

model QuestionLabel {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  questionId Int      @map("question_id")
  labelId    Int      @map("label_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      StudentLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@map("question_labels")
  @@unique([userId, questionId, labelId])
  @@index([userId, questionId])
  @@index([labelId])
}

model QuizSessionLabel {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  quizSessionId Int      @map("quiz_session_id")
  labelId       Int      @map("label_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizSession   QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  label         StudentLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@map("quiz_session_labels")
  @@unique([userId, quizSessionId, labelId])
  @@index([userId, quizSessionId])
  @@index([labelId])
}

model StudentNote {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  questionId Int?     @map("question_id")
  quizId     Int?     @map("quiz_id")
  noteText   String   @map("note_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quiz       Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  noteLabels NoteLabel[]

  @@map("student_notes")
  @@index([userId, questionId])
  @@index([userId, quizId])
}

model NoteLabel {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  noteId    Int      @map("note_id")
  labelId   Int      @map("label_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      StudentNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  label     StudentLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@map("note_labels")
  @@unique([userId, noteId, labelId])
  @@index([userId, noteId])
  @@index([labelId])
}

model QuestionReport {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  questionId    Int      @map("question_id")
  reportType    ReportType
  description   String?
  status        ReportStatus @default(PENDING)
  reviewedById  Int?     @map("reviewed_by")
  adminResponse String?  @map("admin_response")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewedBy    User?    @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("question_reports")
  @@index([userId, questionId])
  @@index([status])
  @@index([reportType])
}

// ===========================================
// TO-DO SYSTEM & CALENDAR
// ===========================================

model TodoItem {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  title           String
  description     String?
  type            TodoType
  priority        Priority @default(MEDIUM)
  status          TodoStatus @default(PENDING)
  dueDate         DateTime? @map("due_date")
  courseId        Int?     @map("course_id")
  quizId          Int?     @map("quiz_id")
  examId          Int?     @map("exam_id")
  quizSessionId   Int?     @map("quiz_session_id")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  quiz            Quiz?    @relation(fields: [quizId], references: [id], onDelete: SetNull)
  exam            Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  quizSession     QuizSession? @relation(fields: [quizSessionId], references: [id], onDelete: SetNull)

  @@map("todo_items")
  @@index([userId, status])
  @@index([dueDate])
  @@index([priority])
}

// ===========================================
// EMPLOYEE ACTIVITY & LOGS
// ===========================================

model EmployeeActivity {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  activityType  ActivityType
  description   String?
  relatedId     Int?     @map("related_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  employee      User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_activities")
  @@index([employeeId, activityType])
  @@index([createdAt])
}

// ===========================================
// ENUMS
// ===========================================

enum UserRole {
  ADMIN
  EMPLOYEE
  STUDENT
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum YearLevel {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
}

enum PackType {
  YEAR
  RESIDENCY
}

enum ResourceType {
  OFFICIAL_SUPPORT
  CHOICE_OF_TEAM
  VIDEO
  AUDIO
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum QuizType {
  PRACTICE
  EXAM
  MOCK
  QCM  // Questions à Choix Multiples (Multiple Choice)
  QCS  // Questions à Choix Simple (Single Choice)
}

enum SessionType {
  PRACTICE
  EXAM
  REMEDIAL
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TodoType {
  READING
  QUIZ
  SESSION
  EXAM
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ReportType {
  INCORRECT_ANSWER
  TYPO
  UNCLEAR_QUESTION
  MISSING_INFO
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum RetakeType {
  SAME          // Retake with exact same questions
  INCORRECT_ONLY // Retake with only previously incorrect answers
  CORRECT_ONLY   // Retake with only previously correct answers
  NOT_RESPONDED  // Retake with only questions that were skipped/not answered
}

enum ActivityType {
  QUESTION_ADDED
  QUESTION_EDITED
  QUESTION_VERIFIED
  COURSE_UPLOADED
  RESOURCE_ADDED
  QUIZ_CREATED
  EXAM_CREATED
  QUIZ_SOURCE_CREATED
  QUIZ_SOURCE_UPDATED
  QUIZ_SOURCE_DELETED
}
