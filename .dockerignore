# Allowlist: the build context contains only what the Dockerfile needs.
# Everything else (.env files, keys, node_modules, build output, docs) stays out.
*
!package.json
!package-lock.json
!tsconfig.json
!prisma/schema.prisma
!prisma/migrations/
!src/
!scripts/docker-entrypoint.sh
# Commit detection for source builds (Dockerfile "version" stage): commit ids and ref
# names only, never .git/config (it can hold credentials)
!.git/HEAD
!.git/refs/heads/
!.git/packed-refs
