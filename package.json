{
  "name": "med-adn-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/app.js",
    "start:prod": "node build/app.js",
    "dev": "tsc && nodemon build/app.js",
    "test": "jest --config scripts/jest.config.js --runInBand --forceExit",
    "test:watch": "jest --config scripts/jest.config.js --watch",
    "test:coverage": "jest --config scripts/jest.config.js --coverage --runInBand --forceExit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node build/seed.js",
    "prisma:performance-seed": "node build/performance-seed.js",
    "prisma:verify-data": "node scripts/verify-performance-data.js",
    "test:payments": "node build/scripts/test-chargily-payments.js"
  },
  "prisma": {
    "seed": "node build/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^6.0.3",
    "axios": "^1.11.0",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.7.3"
  },
  "description": "A starter kit for Express.js with TypeScript, Prisma, and authentication",
  "engines": {
    "node": ">=22"
  }
